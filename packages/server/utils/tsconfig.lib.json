{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "../../..",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "types": ["node"],
    "moduleResolution": "node",
    "module": "commonjs",
    "skipLibCheck": true,
    "strict": false,
    "noImplicitReturns": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"]
}
